# --- WPMCP server runtime ---
WPMCP_HOST=127.0.0.1
WPMCP_PORT=8787
WPMCP_TRANSPORT=http
# Optional bearer token clients must present to call the server.
WPMCP_BEARER_TOKEN=

# --- Default WordPress site (used when a tool omits the `site` argument) ---
WPMCP_DEFAULT_SITE=primary

# --- Registered multisite connections ---
# Each site: WPMCP_SITE_<ALIAS>_URL / _USERNAME / _PASSWORD (Application Password).
WPMCP_SITE_PRIMARY_URL=https://your-site.com
WPMCP_SITE_PRIMARY_USERNAME=admin
WPMCP_SITE_PRIMARY_PASSWORD=your-app-password

# WPMCP_SITE_STAGING_URL=https://staging.your-site.com
# WPMCP_SITE_STAGING_USERNAME=admin
# WPMCP_SITE_STAGING_PASSWORD=your-app-password

# --- Safety ---
# Comma-separated allow-list of destructive actions permitted without extra confirmation.
WPMCP_ALLOW_DESTRUCTIVE=false
